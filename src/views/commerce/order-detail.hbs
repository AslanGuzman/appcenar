<div class="d-flex align-items-center justify-content-between page-header">
  <div>
    <p class="eyebrow">Pedido</p>
    <h2>{{order.commerce.name}}</h2>
    <p class="text-muted small mb-0">Pedido #{{shortId order._id}}</p>
  </div>
  <a href="/commerce/home" class="btn btn-ghost"><i class="bi bi-arrow-left"></i> Volver</a>
</div>

<div class="row g-4">
  <div class="col-lg-7">
    <div class="brand-card p-3">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="status-pill {{statusClass order.status}}">{{statusLabel order.status}}</span>
        <span class="text-muted small">{{formatDate order.createdAt}}</span>
      </div>
      {{#each order.items}}
        <div class="d-flex align-items-center gap-3 border-bottom py-2">
          {{#if this.image}}
            <img src="{{this.image}}" alt="{{this.name}}" style="width:48px;height:48px;object-fit:cover;border-radius:8px" />
          {{else}}
            <div style="width:48px;height:48px;background:var(--brand-secondary-light);border-radius:8px"></div>
          {{/if}}
          <div class="flex-grow-1">
            <div class="fw-semibold">{{this.name}}</div>
            <div class="text-muted small">Cantidad: {{this.quantity}}</div>
          </div>
          <span class="fw-semibold">RD$ {{this.price}}</span>
        </div>
      {{/each}}
      <div class="d-flex justify-content-between fw-bold pt-3">
        <span>Total</span><span>RD$ {{order.total}}</span>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="brand-card p-3">
      {{#if order.delivery}}
        <h6><i class="bi bi-bicycle"></i> Delivery asignado</h6>
        <p class="mb-0">{{order.delivery.firstName}} {{order.delivery.lastName}}</p>
        <p class="text-muted small">{{order.delivery.phone}}</p>
      {{else}}
        <p class="text-muted small mb-3">Aún no se ha asignado un delivery.</p>
      {{/if}}

      {{#if canAssign}}
        <form action="/commerce/orders/{{order._id}}/assign-delivery" method="POST">
          <button type="submit" class="btn btn-brand w-100"><i class="bi bi-bicycle"></i> Asignar delivery</button>
        </form>
      {{/if}}
    </div>
  </div>
</div>
