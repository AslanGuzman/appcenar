<div class="page-header"><h2>{{title}}</h2></div>
<div class="brand-card p-4 mx-auto" style="max-width: 560px">
  <form action="{{formAction}}" method="POST">
    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label">Nombre</label>
        <input type="text" name="firstName" class="form-control" value="{{admin.firstName}}" required />
      </div>
      <div class="col-md-6">
        <label class="form-label">Apellido</label>
        <input type="text" name="lastName" class="form-control" value="{{admin.lastName}}" required />
      </div>
      <div class="col-md-6">
        <label class="form-label">Cédula</label>
        <input type="text" name="identificationCard" class="form-control" value="{{admin.identificationCard}}" required />
      </div>
      <div class="col-md-6">
        <label class="form-label">Usuario</label>
        <input type="text" name="userName" class="form-control" value="{{admin.userName}}" required />
      </div>
      <div class="col-md-6">
        <label class="form-label">Correo</label>
        <input type="email" name="email" class="form-control" value="{{admin.email}}" required />
      </div>
      <div class="col-md-6">
        <label class="form-label">Teléfono</label>
        <input type="text" name="phone" class="form-control" value="{{admin.phone}}" required />
      </div>
      {{#unless admin._id}}
      <div class="col-md-6">
        <label class="form-label">Contraseña</label>
        <input type="password" name="password" class="form-control" required />
      </div>
      <div class="col-md-6">
        <label class="form-label">Confirmar contraseña</label>
        <input type="password" name="confirmPassword" class="form-control" required />
      </div>
      {{else}}
      <div class="col-md-6">
        <label class="form-label">Nueva contraseña (opcional)</label>
        <input type="password" name="password" class="form-control" />
      </div>
      <div class="col-md-6">
        <label class="form-label">Confirmar nueva contraseña</label>
        <input type="password" name="confirmPassword" class="form-control" />
      </div>
      {{/unless}}
    </div>
    <div class="d-flex gap-2 mt-4">
      <a href="/admin/administrators" class="btn btn-ghost">Volver</a>
      <button type="submit" class="btn btn-brand"><i class="bi bi-save"></i> Guardar</button>
    </div>
  </form>
</div>
