<div class="page-header">
  <p class="eyebrow">Panel general</p>
  <h2>Dashboard</h2>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="stat-card">
      <div class="stat-icon"><i class="bi bi-receipt"></i></div>
      <div>
        <div class="stat-value">{{metrics.orders.total}}</div>
        <div class="stat-label">Pedidos totales</div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card">
      <div class="stat-icon"><i class="bi bi-calendar-day"></i></div>
      <div>
        <div class="stat-value">{{metrics.orders.today}}</div>
        <div class="stat-label">Pedidos de hoy</div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="stat-card">
      <div class="stat-icon"><i class="bi bi-box-seam"></i></div>
      <div>
        <div class="stat-value">{{metrics.products.total}}</div>
        <div class="stat-label">Productos creados</div>
      </div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-md-4">
    <div class="brand-card p-3">
      <h6><i class="bi bi-shop"></i> Comercios</h6>
      <div class="d-flex justify-content-between"><span class="text-muted">Activos</span><span class="fw-bold">{{metrics.commerces.active}}</span></div>
      <div class="d-flex justify-content-between"><span class="text-muted">Inactivos</span><span class="fw-bold">{{metrics.commerces.inactive}}</span></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="brand-card p-3">
      <h6><i class="bi bi-people"></i> Clientes</h6>
      <div class="d-flex justify-content-between"><span class="text-muted">Activos</span><span class="fw-bold">{{metrics.clients.active}}</span></div>
      <div class="d-flex justify-content-between"><span class="text-muted">Inactivos</span><span class="fw-bold">{{metrics.clients.inactive}}</span></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="brand-card p-3">
      <h6><i class="bi bi-bicycle"></i> Deliveries</h6>
      <div class="d-flex justify-content-between"><span class="text-muted">Activos</span><span class="fw-bold">{{metrics.deliveries.active}}</span></div>
      <div class="d-flex justify-content-between"><span class="text-muted">Inactivos</span><span class="fw-bold">{{metrics.deliveries.inactive}}</span></div>
    </div>
  </div>
</div>
