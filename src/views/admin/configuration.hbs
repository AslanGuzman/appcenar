<div class="page-header">
  <p class="eyebrow">Sistema</p>
  <h2>Configuración</h2>
</div>

<div class="brand-card p-4 mx-auto" style="max-width: 480px">
  <div class="d-flex align-items-center gap-2 mb-4 p-3" style="background: var(--brand-secondary-light); border-radius: var(--radius-md);">
    <i class="bi bi-info-circle-fill" style="color: var(--brand-secondary); font-size: 1.3rem;"></i>
    <div>
      <div class="small text-muted">Valor actual</div>
      <div class="fw-bold fs-5">ITBIS: {{configuration.value}}%</div>
    </div>
  </div>
  <form action="/admin/configuration" method="POST">
    <div class="mb-3">
      <label class="form-label">Nuevo valor de ITBIS (%)</label>
      <input type="number" step="0.01" name="value" class="form-control" value="{{configuration.value}}" required />
      <div class="form-text">Se aplica al subtotal de cada pedido.</div>
    </div>
    <button type="submit" class="btn btn-brand"><i class="bi bi-save"></i> Guardar cambios</button>
  </form>
</div>
