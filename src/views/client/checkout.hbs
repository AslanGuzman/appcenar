<div class="page-header">
  <p class="eyebrow">Paso final</p>
  <h2>Confirmar pedido</h2>
</div>

<div class="row g-4">
  <div class="col-lg-7">
    <h5 class="mb-3">Selecciona una dirección de entrega</h5>
    {{#if addresses.length}}
      <form action="/client/checkout" method="POST">
        <div class="d-flex flex-column gap-2 mb-3">
          {{#each addresses}}
            <label class="brand-card p-3 d-flex gap-2 align-items-start" style="cursor:pointer">
              <input type="radio" name="addressId" value="{{this._id}}" class="form-check-input mt-1" required />
              <div>
                <div class="fw-semibold">{{this.label}}</div>
                <div class="text-muted small">{{this.street}}, {{this.sector}}, {{this.city}}</div>
                <div class="text-muted small">{{this.reference}}</div>
              </div>
            </label>
          {{/each}}
        </div>
        <button type="submit" class="btn btn-brand w-100 py-2"><i class="bi bi-bag-check"></i> Realizar pedido</button>
      </form>
    {{else}}
      <div class="empty-state">
        <i class="bi bi-geo-alt d-block mb-2"></i>
        No tienes direcciones registradas. <a href="/client/addresses/new">Crea una primero</a>.
      </div>
    {{/if}}
  </div>

  <div class="col-lg-5">
    <div class="brand-card p-3">
      <div class="d-flex align-items-center gap-2 mb-3">
        {{#if commerce.logo}}<img src="{{commerce.logo}}" style="width:44px;height:44px;object-fit:cover;border-radius:10px" />{{/if}}
        <h6 class="mb-0">{{commerce.name}}</h6>
      </div>
      {{#each cart.items}}
        <div class="d-flex justify-content-between small mb-1">
          <span>{{this.name}}</span><span>RD$ {{this.price}}</span>
        </div>
      {{/each}}
      <hr />
      <div class="d-flex justify-content-between small">
        <span>Subtotal</span><span>RD$ {{subtotal}}</span>
      </div>
      <div class="d-flex justify-content-between small">
        <span>ITBIS ({{itbisPercentage}}%)</span><span>RD$ {{itbisAmount}}</span>
      </div>
      <hr />
      <div class="d-flex justify-content-between fw-bold fs-5">
        <span>Total</span><span>RD$ {{total}}</span>
      </div>
    </div>
  </div>
</div>
