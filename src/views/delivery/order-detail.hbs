<div class="d-flex align-items-center justify-content-between page-header">
  <div>
    <p class="eyebrow">Pedido</p>
    <h2>{{order.commerce.name}}</h2>
  </div>
  <a href="/delivery/home" class="btn btn-ghost"><i class="bi bi-arrow-left"></i> Volver</a>
</div>

<div class="row g-4">
  <div class="col-lg-7">
    <div class="brand-card p-3">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="status-pill {{statusClass order.status}}">{{statusLabel order.status}}</span>
        <span class="text-muted small">{{formatDate order.createdAt}}</span>
      </div>
      {{#each order.items}}
        <div class="d-flex justify-content-between border-bottom py-2">
          <span>{{this.name}}</span><span>RD$ {{this.price}}</span>
        </div>
      {{/each}}
      <div class="d-flex justify-content-between fw-bold pt-3">
        <span>Total</span><span>RD$ {{order.total}}</span>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="brand-card p-3">
      {{#if showAddress}}
        <h6><i class="bi bi-geo-alt"></i> Dirección de entrega</h6>
        <p class="mb-0">{{order.address.label}}</p>
        <p class="text-muted small">{{order.address.street}}, {{order.address.sector}}, {{order.address.city}}</p>
        <p class="text-muted small">{{order.address.reference}}</p>
      {{else}}
        <p class="text-muted small">La dirección ya no está disponible para este pedido.</p>
      {{/if}}

      {{#if canComplete}}
        <form action="/delivery/orders/{{order._id}}/complete" method="POST" class="mt-3">
          <button type="submit" class="btn btn-brand w-100"><i class="bi bi-check2-circle"></i> Completar pedido</button>
        </form>
      {{/if}}
    </div>
  </div>
</div>
