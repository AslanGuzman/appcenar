<div class="page-header">
  <p class="eyebrow">Panel del delivery</p>
  <h2>Mis pedidos</h2>
</div>

{{#if orders.length}}
  <div class="d-flex flex-column gap-2">
    {{#each orders}}
      <a href="/delivery/orders/{{this._id}}" class="brand-card p-3 d-flex align-items-center gap-3 text-decoration-none text-reset">
        {{#if this.commerce.logo}}<img src="{{this.commerce.logo}}" style="width:52px;height:52px;object-fit:cover;border-radius:10px" />{{/if}}
        <div class="flex-grow-1">
          <div class="fw-semibold">{{this.commerce.name}}</div>
          <div class="text-muted small">{{this.items.length}} producto(s) · {{formatDate this.createdAt}}</div>
        </div>
        <span class="status-pill {{statusClass this.status}}">{{statusLabel this.status}}</span>
      </a>
    {{/each}}
  </div>
{{else}}
  <div class="empty-state">
    <i class="bi bi-bicycle d-block mb-2"></i>
    Aún no tienes pedidos asignados.
  </div>
{{/if}}
