<div class="row justify-content-center">
  <div class="col-md-7 col-lg-5">
    <div class="brand-card p-4 text-center">
      <i class="bi {{#if ok}}bi-check-circle-fill text-success{{else}}bi-exclamation-triangle-fill text-danger{{/if}}" style="font-size:2.5rem"></i>
      <h2 class="h4 mt-3">{{#if ok}}Cuenta activada{{else}}No se pudo activar{{/if}}</h2>
      <p class="text-muted">{{message}}</p>
      <a href="/auth/login" class="btn btn-brand mt-2"><i class="bi bi-box-arrow-in-right"></i> Ir al inicio de sesión</a>
    </div>
  </div>
</div>
