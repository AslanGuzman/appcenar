<div class="auth-card" style="max-width: 640px">
  <div class="auth-brand">
    <img src="/images/logo.png" alt="AppCenar" class="auth-logo" />
    <h2>Únete a AppCenar</h2>
    <p class="text-muted mb-0">Regístrate como cliente para pedir, o como delivery para repartir</p>
  </div>

  <form action="/auth/register" method="POST" enctype="multipart/form-data" novalidate>
    <div class="row g-3">
      <div class="col-md-6">
        <label class="form-label">Nombre</label>
        <input type="text" name="firstName" class="form-control" required value="{{formData.firstName}}" />
      </div>
      <div class="col-md-6">
        <label class="form-label">Apellido</label>
        <input type="text" name="lastName" class="form-control" required value="{{formData.lastName}}" />
      </div>
      <div class="col-md-6">
        <label class="form-label">Teléfono</label>
        <input type="text" name="phone" class="form-control" required value="{{formData.phone}}" />
      </div>
      <div class="col-md-6">
        <label class="form-label">Correo</label>
        <input type="email" name="email" class="form-control" required value="{{formData.email}}" />
      </div>
      <div class="col-md-6">
        <label class="form-label">Nombre de usuario</label>
        <input type="text" name="userName" class="form-control" required value="{{formData.userName}}" />
      </div>
      <div class="col-md-6">
        <label class="form-label">Quiero registrarme como</label>
        <select name="role" class="form-select" required>
          <option value="Client" {{#if (eq formData.role "Client")}}selected{{/if}}>Cliente</option>
          <option value="Delivery" {{#if (eq formData.role "Delivery")}}selected{{/if}}>Delivery</option>
        </select>
      </div>
      <div class="col-md-6">
        <label class="form-label">Contraseña</label>
        <input type="password" name="password" class="form-control" required />
      </div>
      <div class="col-md-6">
        <label class="form-label">Confirmar contraseña</label>
        <input type="password" name="confirmPassword" class="form-control" required />
      </div>
      <div class="col-12">
        <label class="form-label">Foto de perfil</label>
        <input type="file" name="profileImage" class="form-control" accept="image/*" />
      </div>
    </div>

    <button type="submit" class="btn btn-brand w-100 py-2 mt-4">
      <i class="bi bi-check2-circle"></i> Crear cuenta
    </button>
  </form>

  <p class="text-center small text-muted mt-3 mb-0">
    ¿Ya tienes cuenta? <a href="/auth/login">Inicia sesión</a>
  </p>
</div>
