<div class="auth-card">
  <div class="auth-brand">
    <img src="/images/logo.png" alt="AppCenar" class="auth-logo" />
    <h2>Bienvenido de nuevo</h2>
    <p class="text-muted mb-0">Inicia sesión para continuar con tu pedido</p>
  </div>

  <form action="/auth/login" method="POST" novalidate>
    <div class="mb-3">
      <label class="form-label">Usuario o correo</label>
      <input type="text" name="userNameOrEmail" class="form-control" required value="{{formData.userNameOrEmail}}" autofocus />
    </div>
    <div class="mb-3">
      <label class="form-label">Contraseña</label>
      <input type="password" name="password" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-brand w-100 py-2">
      <i class="bi bi-box-arrow-in-right"></i> Ingresar
    </button>
  </form>

  <div class="text-center mt-3">
    <a href="/auth/forgot-password" class="small text-muted">¿Olvidaste tu contraseña?</a>
  </div>

  <hr class="my-4" />

  <p class="text-muted small mb-2 text-center">¿Aún no tienes cuenta?</p>
  <div class="d-flex flex-column flex-sm-row gap-2">
    <a href="/auth/register" class="btn btn-brand-outline flex-fill">
      <i class="bi bi-person-plus"></i> Cliente / Delivery
    </a>
    <a href="/auth/register-commerce" class="btn btn-ghost flex-fill">
      <i class="bi bi-shop"></i> Registrar comercio
    </a>
  </div>
</div>
