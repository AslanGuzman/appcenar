<div class="auth-card">
  <div class="auth-brand">
    <img src="/images/logo.png" alt="AppCenar" class="auth-logo" />
    <h2>Recupera tu acceso</h2>
    <p class="text-muted mb-0">Te enviaremos un enlace a tu correo para restablecer tu contraseña</p>
  </div>
  <form action="/auth/forgot-password" method="POST" novalidate>
    <div class="mb-3">
      <label class="form-label">Usuario o correo</label>
      <input type="text" name="userNameOrEmail" class="form-control" required value="{{formData.userNameOrEmail}}" autofocus />
    </div>
    <button type="submit" class="btn btn-brand w-100 py-2">
      <i class="bi bi-send"></i> Enviar enlace
    </button>
  </form>
  <p class="text-center small text-muted mt-3 mb-0">
    <a href="/auth/login">Volver al inicio de sesión</a>
  </p>
</div>
