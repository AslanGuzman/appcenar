<div class="auth-card">
  <div class="auth-brand">
    <img src="/images/logo.png" alt="AppCenar" class="auth-logo" />
    <h2>Nueva contraseña</h2>
    <p class="text-muted mb-0">Elige una contraseña segura para tu cuenta</p>
  </div>
  <form action="/auth/reset-password" method="POST" novalidate>
    <input type="hidden" name="token" value="{{token}}" />
    <div class="mb-3">
      <label class="form-label">Nueva contraseña</label>
      <input type="password" name="password" class="form-control" required autofocus />
    </div>
    <div class="mb-3">
      <label class="form-label">Confirmar contraseña</label>
      <input type="password" name="confirmPassword" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-brand w-100 py-2">
      <i class="bi bi-check2-circle"></i> Guardar nueva contraseña
    </button>
  </form>
</div>
