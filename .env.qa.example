# =========================================
# .env.qa.example - Copiar como .env.qa
# Se carga automáticamente al ejecutar con NODE_ENV=qa
# =========================================

# Entorno y servidor
NODE_ENV=qa
PORT=8081
APP_URL=http://localhost:8081

# Base de datos (qa debe apuntar a una base distinta de development)
MONGO_URI=mongodb://127.0.0.1:27017/appcenar_qa

# JWT (usado por la API)
JWT_SECRET=CHANGE_THIS_SECRET_KEY
JWT_EXPIRES_IN=1d

# Sesiones (usado por el sitio web)
SESSION_SECRET=CHANGE_THIS_SESSION_SECRET

# Correo
EMAIL_TRANSPORT=nodemailer
EMAIL_FROM=your_sender@gmail.com
EMAIL_FROM_NAME=AppCenar
EMAIL_SERVICE=gmail
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=your_sender@gmail.com
EMAIL_PASS=your_app_password
BREVO_API_KEY=

# Administrador por defecto (no modificable, se crea automáticamente al iniciar)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@appcenar.com
DEFAULT_ADMIN_PASSWORD=Admin123!

# Configuración inicial del sistema
DEFAULT_ITBIS=18

# Datos de demostración para pruebas de QA
SEED_DEMO_DATA=true
