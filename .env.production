# =========================================
# .env.production - usado por la rama main
# =========================================
# IMPORTANTE: estos son valores de PLANTILLA. En Railway, las variables
# reales se configuran en el dashboard del servicio (Settings > Variables).
# Esas variables inyectadas por Railway siempre tienen prioridad sobre lo
# que esté escrito aquí, así que este archivo NUNCA debe tener secretos
# reales de producción.

# Entorno y servidor
NODE_ENV=production
PORT=8080
APP_URL=https://CAMBIA-ESTO.up.railway.app

# Base de datos (production debe apuntar a su propia base, distinta de dev y qa)
MONGO_URI=mongodb://127.0.0.1:27017/appcenar_production

# JWT (usado por la API)
JWT_SECRET=CHANGE_THIS_SECRET_KEY
JWT_EXPIRES_IN=1d

# Sesiones (usado por el sitio web)
SESSION_SECRET=CHANGE_THIS_SESSION_SECRET

# Correo (Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Administrador por defecto (no modificable, se crea automáticamente al iniciar)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@appcenar.com
DEFAULT_ADMIN_PASSWORD=Admin123!

# Configuración inicial del sistema
DEFAULT_ITBIS=18

# En producción real NO se deben sembrar datos de demostración
SEED_DEMO_DATA=false
