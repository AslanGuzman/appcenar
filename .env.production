# Entorno y servidor
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080

# Base de datos (development y qa deben apuntar a bases distintas)
MONGO_URI=mongodb://127.0.0.1:27017/appcenar_dev

# JWT (usado por la API)
JWT_SECRET=CHANGE_THIS_SECRET_KEY
JWT_EXPIRES_IN=1d

# Sesiones (usado por el sitio web)
SESSION_SECRET=CHANGE_THIS_SESSION_SECRET

# Correo (Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Administrador por defecto (no modificable, se crea automáticamente al iniciar)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@appcenar.com
DEFAULT_ADMIN_PASSWORD=Admin123!

# Configuración inicial del sistema
DEFAULT_ITBIS=18

# Sembrar datos de demostración (comercios, productos, clientes, deliveries,
# pedidos de ejemplo) automáticamente al levantar el servidor.
# Ponlo en "false" cuando ya no lo necesites (ej. antes de la entrega final).
SEED_DEMO_DATA=true
